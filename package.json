{
  "name": "trip-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -k -n api,web \"tsx watch server/dev.ts\" \"vite\"",
    "dev": "npm start",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
