# Copy to .env — the app runs in mock mode without any key.
#
# LLM_PROVIDER: "groq" | "mock". Defaults to "groq" when GROQ_API_KEY is set,
# otherwise falls back to "mock" (deterministic fixtures, no network).
# The key is read ONLY by the Node server (server/), never by client code —
# there is deliberately no VITE_ prefix here, so Vite can never inline it.

# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

PORT=8787
